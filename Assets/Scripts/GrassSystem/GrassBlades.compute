// Grass compute shader — 2D instanced blade output
// Outputs one GrassInstanceData per visible blade.
// Wind, taper, and interaction are handled in the vertex shader (GrassSurface_URP).

#pragma kernel Main
#pragma kernel Regrowth

#define TWO_PI 6.28318530717958647693

// ── Structs ───────────────────────────────────────────────────────────────────

// Source vertex — matches GrassData in C# (44 bytes, layout must match exactly)
struct SourceVertex
{
    float3 positionWS;  // 12
    float3 normalOS;    // 12
    float2 uv;          // 8  (x=widthMul, y=heightMul)
    float3 color;       // 12
};

// Cut state — matches GrassCutData in C# (8 bytes)
struct GrassCutData
{
    float cutValue;   // 0=full, 1=cut
    float growTimer;
};

// Per-blade instance data written by compute, read by vertex shader.
// Must match GrassInstanceData in C# and HLSL exactly (48 bytes).
struct GrassInstanceData
{
    float3 positionWS;  // 12 — blade base in world space
    float3 normal;      // 12 — surface normal (blade grows along this)
    float3 color;       // 12 — per-blade diffuse color
    float  width;       //  4
    float  height;      //  4 — already scaled by cut state
    float  seed;        //  4 — random per-blade, used for wind phase in vertex shader
};

// ── Buffers ───────────────────────────────────────────────────────────────────

StructuredBuffer<SourceVertex>        _SourceVertices;
StructuredBuffer<int>                 _VisibleIDBuffer;
RWStructuredBuffer<GrassCutData>      _CutBuffer;
RWStructuredBuffer<GrassInstanceData> _InstanceBuffer;
// args[0]=indexCount(mesh), args[1]=instanceCount(written here), args[2..4]=0
RWStructuredBuffer<uint>              _IndirectArgsBuffer;

// ── Uniforms ──────────────────────────────────────────────────────────────────

int   _NumSourceVertices;
int   _MaxBladesPerVertex;
int   _MaxInstanceCount;    // hard cap = grassData.Count * allowedBladesPerVertex

float _Time;
float _DeltaTime;
float _RegrowTime;

float _GrassRandomHeightMin, _GrassRandomHeightMax;
float _MinHeight, _MaxHeight;
float _MinWidth,  _MaxWidth;
float _MinFadeDist, _MaxFadeDist;

float3 _CameraPositionWS;

// ── Helpers ───────────────────────────────────────────────────────────────────

float rand(float3 co)
{
    return frac(sin(dot(co.xyz, float3(12.9898, 78.233, 53.539))) * 43758.5453);
}

float randRange(float2 seed, float lo, float hi)
{
    return lerp(lo, hi, frac(sin(dot(seed, float2(12.9898, 78.233))) * 43758.5453));
}

float3x3 AngleAxis3x3(float angle, float3 axis)
{
    float c, s;
    sincos(angle, s, c);
    float t = 1 - c;
    float x = axis.x, y = axis.y, z = axis.z;
    return float3x3(
        t*x*x + c,   t*x*y - s*z, t*x*z + s*y,
        t*x*y + s*z, t*y*y + c,   t*y*z - s*x,
        t*x*z - s*y, t*y*z + s*x, t*z*z + c
    );
}

// ── Regrowth kernel ───────────────────────────────────────────────────────────

[numthreads(128, 1, 1)]
void Regrowth(uint id : SV_DispatchThreadID)
{
    if ((int)id >= _NumSourceVertices) return;

    GrassCutData cut = _CutBuffer[id];
    if (cut.cutValue <= 0.0) return;

    cut.growTimer += _DeltaTime;
    cut.cutValue   = saturate(1.0 - cut.growTimer / _RegrowTime);
    if (cut.cutValue <= 0.0) { cut.cutValue = 0.0; cut.growTimer = 0.0; }
    _CutBuffer[id] = cut;
}

// ── Main kernel ───────────────────────────────────────────────────────────────
// One thread per visible grass data point.
// Each thread emits up to _MaxBladesPerVertex GrassInstanceData entries.

[numthreads(128, 1, 1)]
void Main(uint id : SV_DispatchThreadID)
{
    if ((int)id >= _NumSourceVertices) return;

    int usableID = _VisibleIDBuffer[id];
    if (usableID == -1) return;

    SourceVertex sv = _SourceVertices[usableID];

    // Distance fade
    float dist = distance(sv.positionWS, _CameraPositionWS);
    float fade = 1.0 - saturate((dist - _MinFadeDist) / max(_MaxFadeDist - _MinFadeDist, 0.001));
    if (fade <= 0.0) return;

    // Cut state
    GrassCutData cut = _CutBuffer[usableID];
    float heightScale = 1.0 - cut.cutValue;
    if (heightScale <= 0.001) return;

    float baseHeight = clamp(
        sv.uv.y + randRange(sv.positionWS.xy, _GrassRandomHeightMin, _GrassRandomHeightMax),
        _MinHeight, _MaxHeight);
    float baseWidth = clamp(sv.uv.x, _MinWidth, _MaxWidth);

    int numBlades = max(1, (int)(_MaxBladesPerVertex * fade));

    for (int j = 0; j < numBlades; j++)
    {
        float bladeSeed = rand(sv.positionWS.xyz + float3(j, j * 7.3, j * 3.1));

        // Small random position spread around the grass point
        float3x3 rot    = AngleAxis3x3(bladeSeed * TWO_PI, sv.normalOS);
        float    spread = bladeSeed * 0.04;
        float3   bladePos = sv.positionWS + mul(rot, float3(spread, 0, 0));

        GrassInstanceData inst;
        inst.positionWS = bladePos;
        inst.normal     = sv.normalOS;
        inst.color      = sv.color;
        inst.width      = baseWidth  * lerp(0.7, 1.3, bladeSeed);
        inst.height     = baseHeight * lerp(0.7, 1.3, frac(bladeSeed * 3.7)) * heightScale;
        inst.seed       = bladeSeed;

        uint idx;
        InterlockedAdd(_IndirectArgsBuffer[1], 1, idx);
        if (idx < (uint)_MaxInstanceCount)
            _InstanceBuffer[idx] = inst;
    }
}
